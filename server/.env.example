# Port the API listens on.
PORT=5050

# Origin of the web client, used for CORS.
CLIENT_ORIGIN=http://localhost:5173

# OpenAI (optional, tried first). Create a key at https://platform.openai.com/api-keys and never commit it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# minimal, low, medium or high; empty for models without reasoning.
OPENAI_REASONING_EFFORT=low

# Google Gemini (optional, used when OpenAI is not set or not answering). Without a key, every AI role uses its built-in fallback.
# Create a key at https://aistudio.google.com/apikey and never commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used in order when the main model is busy or rate limited.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite

# Secret used to sign Verified Work Records. Use a long random string.
RECORD_SECRET=change-me-to-a-long-random-string

# Maximum seconds a test run may take before it is stopped.
TEST_RUN_TIMEOUT_SECONDS=20
